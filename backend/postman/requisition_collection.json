{
  "info": {
    "_postman_id": "b1c2d3e4-f5a6-7890-1234-abcdefabcdef",
    "name": "Enterprise Procurement - Requisition API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"assistanttester\",\n  \"password\": \"Test@1234\",\n  \"fullName\": \"Assistant Tester\",\n  \"email\": \"assistanttester@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api","auth","register"]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"assistanttester\",\n  \"password\": \"Test@1234\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
      }
    },
    {
      "name": "Create Requisition",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New Laptops\",\n  \"justification\": \"Replace old machines\",\n  \"neededBy\": \"2026-08-15\",\n  \"categoryId\": 1,\n  \"supplierId\": 1,\n  \"items\": [\n    { \"description\": \"Dell Latitude\", \"quantity\": 5, \"unitPrice\": 1200.00 }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/requisitions", "host": ["{{baseUrl}}"], "path": ["api","requisitions"] }
      }
    },
    {
      "name": "Get My Requisitions",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/requisitions/my", "host": ["{{baseUrl}}"], "path": ["api","requisitions","my"] }
      }
    },
    {
      "name": "Act On Requisition (Approve/Reject)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"action\": \"APPROVE\",\n  \"remarks\": \"Looks good\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/requisitions/:id/actions", "host": ["{{baseUrl}}"], "path": ["api","requisitions",":id","actions"] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ]
}
